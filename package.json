{
  "name": "@bgmx/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "bgmc": "tsx packages/bgmc/src/cli.ts",
    "bgmx": "tsx apps/bgmx/src/cli.ts",
    "build": "turbo run build",
    "deploy:bgmw": "pnpm -C apps/bgmw run deploy",
    "dev": "turbo run dev --parallel",
    "format": "turbo run format --parallel",
    "release:bgmc": "pnpm -C packages/bgmc release",
    "release:bgmt": "pnpm -C packages/bgmt release",
    "release:bgmx": "pnpm -C apps/bgmx release",
    "release:tmdbc": "pnpm -C packages/tmdbc release",
    "test:ci": "turbo run test:ci",
    "tmdbc": "tsx packages/tmdbc/src/cli.ts",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci",
    "postversion": "turbo run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "bangumi-data": ">=0.3.214",
    "bumpp": "latest",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "release-it": "^21.1.2",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
