{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test:ci": {
      "dependsOn": ["build", "typecheck"]
    },
    "format": {
      "inputs": ["src/**/*.ts", "test/**/*.ts"]
    },
    "dev": {
      "cache": false
    }
  },
  "globalDependencies": ["tsconfig.base.json"]
}
